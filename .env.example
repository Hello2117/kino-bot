# ============================================================
# KINO BOT — ENVIRONMENT VARIABLES
# Never commit this file. Add .env to .gitignore.
# ============================================================

# Anthropic (Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Booqable — regenerate in Booqable > Settings > API
BOOQABLE_API_KEY=your_new_booqable_api_key_here
BOOQABLE_BASE_URL=https://YOUR_COMPANY.booqable.com/api/1

# ── Meta Cloud API ────────────────────────────────────────────
# From Meta Developer App > WhatsApp > Configuration
META_VERIFY_TOKEN=make_up_any_random_string_here
# e.g. META_VERIFY_TOKEN=kino2117verifyXYZ

# ── Respond.io ───────────────────────────────────────────────
# From Respond.io > Settings > Developer > API Keys
RESPOND_API_KEY=your_respond_io_api_key_here

# From Respond.io > Settings > Channels > WhatsApp > Channel ID
# (shown as a number in the URL or channel settings)
RESPOND_CHANNEL_ID=your_whatsapp_channel_id_here

# ── Telegram alerts (optional — for handoff notifications) ────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_group_chat_id

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Any strong random string — used to protect /admin endpoints
ADMIN_SECRET=make_up_a_strong_random_secret_here
